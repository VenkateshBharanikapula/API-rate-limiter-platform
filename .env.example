# --- App ---
APP_NAME="API Rate Limiting & API Key Management Platform"
ENVIRONMENT=local
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-string-in-prod

# --- Database ---
# Used by the running app (async driver)
DATABASE_URL=postgresql+asyncpg://ratelimiter:ratelimiter@postgres:5432/ratelimiter
# Used by Alembic migrations (sync driver, runs outside the event loop)
DATABASE_URL_SYNC=postgresql+psycopg2://ratelimiter:ratelimiter@postgres:5432/ratelimiter

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Rate Limiting Defaults ---
# Used when a client has no explicit RateLimitConfig row yet
DEFAULT_RATE_LIMIT_REQUESTS=10
DEFAULT_RATE_LIMIT_WINDOW_SECONDS=60

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
